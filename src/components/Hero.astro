---
// Reemplaza el Hero de Starlight (solo lo usa la portada).
import { LinkButton } from '@astrojs/starlight/components';
import Mosaico from './Mosaico.astro';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
---
<div class="hero">
	<div class="texto">
		<h1 id="_top" set:html={title} />
		{tagline && <p class="tagline" set:html={tagline} />}
		{actions.length > 0 && (
			<div class="acciones">
				{actions.map(({ text, link, variant, icon, attrs }) => (
					<LinkButton href={link} variant={variant} icon={icon?.name} {...attrs}>{text}{icon?.html && <Fragment set:html={icon.html} />}</LinkButton>
				))}
			</div>
		)}
	</div>
	<div class="mosaico-wrap"><Mosaico /></div>
</div>

<style>
	.hero {
		display: grid;
		gap: 2.5rem;
		align-items: center;
		padding-block: 2.5rem 1rem;
	}
	@media (min-width: 50rem) {
		.hero { grid-template-columns: 1.5fr 1fr; padding-block: 3rem 1.5rem; }
		.mosaico-wrap { display: flex; justify-content: flex-end; }
	}
	h1 {
		margin-top: 0.5rem;
		font-size: clamp(1.75rem, 3.6vw, 2.5rem);
		line-height: 1.1;
		font-weight: 700;
		letter-spacing: -0.015em;
		color: var(--sl-color-white);
	}
	.tagline { margin-top: 1rem; font-size: 1.1rem; line-height: 1.6; color: var(--sl-color-gray-2); max-width: 34rem; }
	.acciones { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }
</style>
